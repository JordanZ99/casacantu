---
import { ArrowRight } from '@lucide/astro';
// About — Quiénes somos — asymmetric layout with decorative elements
---

<section class="section section--dark section--striped about" id="nosotros">
  <div class="container">
    <div class="about__grid">
      <div class="about__text gsap-fade-up">
        <h2 class="section__title">Quiénes somos</h2>
        <p class="about__copy">
          Casa Cantú es una empresa dedicada al suministro y desarrollo de soluciones industriales.
          Tenemos todo lo que tu industria necesita para seguir trabajando sin parar — con entregas
          rápidas en Monterrey y su área metropolitana, atención personalizada y precios competitivos.
        </p>
        <a href="#productos" class="btn btn--outline">
          Ver productos
          <ArrowRight size={16} />
        </a>
      </div>

      <div class="about__image gsap-fade-up">
        <!-- TODO: reemplazar con imagen real -->
        <div class="img-placeholder">
          <img
            src="/images/instalaciones.png"
            alt="Instalaciones de Casa Cantú en Monterrey — planta industrial"
            loading="lazy"
            width="640"
            height="400"
            style="display:none;"
            onerror="this.style.display='none'; this.parentElement.classList.add('has-image');"
            onload="this.style.display='block'; this.parentElement.classList.add('has-image');"
          />
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
          </svg>
          <span>Instalaciones</span>
        </div>
      </div>
    </div>
  </div>
</section>
