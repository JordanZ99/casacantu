---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Casa Cantú | Soluciones Industriales en Monterrey',
  description = 'Casa Cantú es una empresa dedicada al suministro y desarrollo de soluciones industriales. Tenemos todo lo que tu industria necesita para seguir trabajando sin parar — con entregas rápidas en Monterrey y su área metropolitana, atención personalizada y precios competitivos.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#000000" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_MX" />

  <title>{title}</title>

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/logo.png" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Oswald:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <!-- Global Styles -->
</head>
<body>
  <slot />
</body>
</html>
