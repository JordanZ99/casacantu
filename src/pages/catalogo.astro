---

<BaseLayout title="Catálogo de Productos | Casa Cantú" description="Conoce nuestra línea completa de productos industriales: bandas, mangueras, adhesivos, abrasivos, plásticos de ingeniería y más.">
  <Header />
  <main class="catalogo">

    <!-- ============ HERO ============ -->
    <section class="catalogo__hero">
      <div class="catalogo__hero-bg"></div>
      <div class="catalogo__hero-content">
        <a href="/" class="catalogo__back">
          <ArrowLeft size={18} />
          Volver al inicio
        </a>
        <h1 class="catalogo__title">Catálogo de productos</h1>
        <p class="catalogo__subtitle">
          Línea completa de soluciones industriales para tu empresa.
          Explora nuestras categorías y encuentra lo que necesitas.
        </p>
        <div class="catalogo__search" role="search">
          <Search size={18} class="catalogo__search-icon" />
          <input
            type="text"
            class="catalogo__search-input"
            id="catalogoSearch"
            placeholder="Buscar productos…"
            autocomplete="off"
          />
        </div>
      </div>
    </section>

    <!-- Live search results -->
    <div class="container">
      <div class="catalogo__search-results" id="searchResults" aria-live="polite"></div>
    </div>

    <!-- ============ STICKY TABS ============ -->
    <nav class="catalogo__tabs" id="catalogoTabs">
      <div class="container">
        <div class="catalogo__tabs-scroll">
          {categories.map((cat) => (
            <a
              href={`#cat-${cat.id}`}
              class="catalogo__tab"
              data-target={cat.id}
            >
              {cat.shortName}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <!-- ============ CATEGORIES ============ -->
    <section class="catalogo__grid section" id="catalogoGrid">
      <div class="container">
        <div class="catalogo__counter" id="counter">
          {categories.length} categorías
        </div>

        <div class="catalogo__categories" id="categoriesContainer">
          {categories.map((cat) => (
            <article class="cat-section" id={`cat-${cat.id}`} data-category={cat.id}>

              <!-- Category header (clickable toggle) -->
              <button class="cat-section__header" aria-expanded="false">
                <div class="cat-section__icon">
                  <cat.icon size={22} />
                </div>
                <div class="cat-section__header-text">
                  <h2 class="cat-section__title">
                    {cat.title}
                    <span class="cat-section__count">{cat.items.length} productos</span>
                  </h2>
                  <p class="cat-section__desc">{cat.desc}</p>
                </div>
                <ChevronDown size={18} class="cat-section__chevron" />
              </button>

              <!-- All product cards (hidden, revealed on header click) -->
              <div class="cat-section__extra">
                <div class="cat-section__grid">
                  {cat.items.map((item) => (
                    <div class="cat-section__product">
                      <div class="cat-section__product-img">
                        <div class="img-placeholder">
                          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                            <circle cx="8.5" cy="8.5" r="1.5"/>
                            <polyline points="21 15 16 10 5 21"/>
                          </svg>
                          <span class="cat-section__product-imagen-text">Imagen próximamente</span>
                        </div>
                      </div>
                      <p class="cat-section__product-name">{item}</p>
                    </div>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="catalogo__cta section section--dark">
      <div class="container">
        <div class="catalogo__cta-box">
          <h2 class="catalogo__cta-title">¿No encuentras lo que buscas?</h2>
          <p class="catalogo__cta-desc">
          Contáctanos y te asesoramos personalmente. Tenemos soluciones
          a la medida para tu industria.
          </p>
          <a
            href="https://wa.me/528122325286"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--primary btn--large"
          >
            Cotizar ahora
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // ========================
    // STICKY TABS — highlight active + scroll to + open
    // ========================
    const tabs = document.querySelectorAll('.catalogo__tab');
    const sections = document.querySelectorAll('.cat-section');

    tabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const target = tab.getAttribute('data-target');
        const el = document.getElementById(`cat-${target}`);
        if (el) {
          const offset = 100;
          const top = el.getBoundingClientRect().top + window.scrollY - offset;
          window.scrollTo({ top, behavior: 'smooth' });

          // Open the target section after scrolling
          setTimeout(() => {
            openSectionByTarget(target);
          }, 400);
        }
      });
    });

    // Highlight active tab on scroll
    sections.forEach((section) => {
      ScrollTrigger.create({
        trigger: section,
        start: 'top 50px',
        end: 'bottom 50px',
        onEnter: () => setActiveTab(section.dataset.category),
        onEnterBack: () => setActiveTab(section.dataset.category),
      });
    });

    // Set first tab active by default
    if (tabs.length) tabs[0].classList.add('active');

    function setActiveTab(id) {
      tabs.forEach((t) => {
        t.classList.toggle('active', t.dataset.target === id);
      });
    }

    function openSectionByTarget(targetId) {
      const section = document.querySelector(`.cat-section[data-category="${targetId}"]`);
      if (!section || section.classList.contains('open')) return;

      const header = section.querySelector('.cat-section__header');
      const extra = section.querySelector('.cat-section__extra');
      if (!header || !extra) return;

      // Close any open section first
      if (currentOpen && currentOpen !== section) {
        closeSection(currentOpen);
      }

      const products = extra.querySelectorAll('.cat-section__product');
      openSection(section, extra, products, header);
    }

    // ========================
    // SEARCH FILTER
    // ========================
    const searchInput = document.getElementById('catalogoSearch');
    const counter = document.getElementById('counter');
    const searchResults = document.getElementById('searchResults');

    searchInput?.addEventListener('input', function () {
      const q = this.value.toLowerCase().trim();
      let visible = 0;

      sections.forEach((section) => {
        const title = section.querySelector('.cat-section__title')?.textContent?.toLowerCase() || '';
        const allNames = Array.from(section.querySelectorAll('.cat-section__product-name'));
        const texts = allNames.map((el) => el.textContent?.toLowerCase() || '');
        const matches = !q || [title, ...texts].some((t) => t.includes(q));

        section.classList.toggle('hidden', !matches);
        allNames.forEach((el) => {
          el.classList.toggle('match', q && el.textContent?.toLowerCase().includes(q));
        });
        if (matches) visible++;
      });

      if (counter) counter.textContent = `${visible} de ${sections.length} categorías`;

      if (searchResults) {
        if (q && visible === 0) {
          searchResults.innerHTML = `<div class="catalogo__search-noresults">No se encontraron productos que coincidan con "<strong>${q}</strong>"</div>`;
          searchResults.classList.add('visible');
        } else {
          searchResults.classList.remove('visible');
          searchResults.innerHTML = '';
        }
      }
    });

    // ========================
    // ACCORDION — header click toggles, single open at a time, GSAP anim
    // ========================
    let currentOpen = null;

    sections.forEach((section) => {
      const header = section.querySelector('.cat-section__header');
      const extra = section.querySelector('.cat-section__extra');

      if (!header || !extra) return;

      const products = extra.querySelectorAll('.cat-section__product');

      header.addEventListener('click', () => {
        const isOpen = section.classList.contains('open');

        if (!isOpen && currentOpen && currentOpen !== section) {
          closeSection(currentOpen);
        }

        if (isOpen) {
          closeSection(section);
        } else {
          openSection(section, extra, products, header);
        }
      });
    });

    function openSection(section, extra, products, headerBtn) {
      extra.style.display = 'block';
      extra.style.overflow = 'visible';
      extra.style.height = 'auto';
      extra.style.opacity = '1';
      const fullHeight = extra.offsetHeight;
      extra.style.height = '0';
      extra.style.overflow = 'hidden';
      extra.style.opacity = '0';

      section.classList.add('open');
      currentOpen = section;
      headerBtn.setAttribute('aria-expanded', 'true');

      gsap.to(extra, {
        height: fullHeight,
        opacity: 1,
        duration: 0.45,
        ease: 'power3.out',
        onComplete: () => {
          extra.style.height = 'auto';
          extra.style.overflow = 'visible';
        },
      });

      gsap.fromTo(
        products,
        { opacity: 0, y: 14 },
        {
          opacity: 1,
          y: 0,
          duration: 0.35,
          stagger: 0.04,
          ease: 'power2.out',
          delay: 0.1,
        }
      );
    }

    function closeSection(section) {
      const extra = section.querySelector('.cat-section__extra');
      const headerBtn = section.querySelector('.cat-section__header');
      const products = extra?.querySelectorAll('.cat-section__product') || [];

      if (!extra) return;

      section.classList.remove('open');
      headerBtn?.setAttribute('aria-expanded', 'false');
      currentOpen = null;

      gsap.to(extra, {
        height: 0,
        opacity: 0,
        duration: 0.3,
        ease: 'power2.in',
        onComplete: () => {
          extra.style.display = 'none';
          extra.style.height = '0';
          extra.style.overflow = 'hidden';
        },
      });

      gsap.to(products, {
        opacity: 0,
        y: -8,
        duration: 0.2,
        ease: 'power2.in',
      });
    }
  </script>
</BaseLayout>

<style>
  /* ========================================
     CATÁLOGO PAGE STYLES
     ======================================== */

  /* --- Hero --- */
  .catalogo__hero {
    position: relative;
    padding: calc(var(--header-height) + var(--space-2xl)) var(--space-md) var(--space-2xl);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 380px;
  }

  .catalogo__hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 30% 40%, rgba(255, 215, 0, 0.04) 0%, transparent 70%),
      linear-gradient(180deg, var(--color-black) 0%, var(--color-dark-1) 100%);
    z-index: 0;
  }

  .catalogo__hero-content {
    position: relative;
    z-index: 1;
    max-width: 720px;
    text-align: center;
  }

  .catalogo__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: var(--space-lg);
    transition: color var(--transition-fast);
  }

  .catalogo__back:hover {
    color: var(--color-accent);
  }

  .catalogo__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: var(--color-white);
    margin-bottom: var(--space-sm);
    letter-spacing: 0.04em;
  }

  .catalogo__subtitle {
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    color: rgba(255, 255, 255, 0.65);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0.01em;
    max-width: 540px;
    margin: 0 auto var(--space-lg);
    line-height: 1.7;
  }

  /* --- Search --- */
  .catalogo__search {
    position: relative;
    max-width: 480px;
    margin: 0 auto;
  }

  .catalogo__search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-dark-5);
    pointer-events: none;
  }

  .catalogo__search-input {
    width: 100%;
    padding: 0.9rem 1rem 0.9rem 2.8rem;
    background: var(--color-dark-2);
    border: 1px solid var(--color-dark-4);
    border-radius: var(--radius-md);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 0.95rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    outline: none;
  }

  .catalogo__search-input::placeholder {
    color: var(--color-dark-5);
  }

  .catalogo__search-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px hsla(50, 100%, 50%, 0.12);
  }

  /* --- Search results --- */
  .catalogo__search-results {
    display: none;
    margin-top: var(--space-md);
  }

  .catalogo__search-results.visible {
    display: block;
  }

  .catalogo__search-noresults {
    text-align: center;
    padding: var(--space-xl) var(--space-md);
    color: rgba(255, 255, 255, 0.5);
    font-size: 1rem;
    background: var(--color-dark-2);
    border-radius: var(--radius-md);
    border: 1px dashed var(--color-dark-4);
  }

  .catalogo__search-noresults strong {
    color: var(--color-accent);
  }

  /* ========================================
     STICKY TABS
     ======================================== */
  .catalogo__tabs {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border-top: 1px solid var(--color-dark-4);
    border-bottom: 1px solid var(--color-dark-4);
    overflow: hidden;
  }

  .catalogo__tabs-scroll {
    display: flex;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .catalogo__tabs-scroll::-webkit-scrollbar {
    display: none;
  }

  .catalogo__tab {
    flex-shrink: 0;
    padding: 0.7rem 1rem;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.45);
    transition: color var(--transition-fast), background var(--transition-fast);
    white-space: nowrap;
    position: relative;
    border-right: 1px solid var(--color-dark-4);
  }

  .catalogo__tab:last-child {
    border-right: none;
  }

  .catalogo__tab:hover {
    color: var(--color-white);
  }

  .catalogo__tab.active {
    color: var(--color-accent);
    background: var(--color-accent-faint);
  }

  .catalogo__tab.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0.5rem;
    right: 0.5rem;
    height: 2px;
    background: var(--color-accent);
    border-radius: 1px;
  }

  /* --- Counter --- */
  .catalogo__counter {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-dark-5);
    margin-bottom: var(--space-lg);
  }

  /* ========================================
     CATEGORY SECTIONS
     ======================================== */
  .catalogo__categories {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .cat-section {
    scroll-margin-top: 50px;
    border-bottom: 1px solid var(--color-dark-4);
  }

  .cat-section:last-child {
    border-bottom: none;
  }

  .cat-section.open {
    padding-bottom: var(--space-md);
  }

  .cat-section.hidden {
    display: none;
  }

  /* --- Header (clickable toggle) --- */
  .cat-section__header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    padding: var(--space-md) 0;
    background: none;
    border: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-align: left;
    transition: opacity var(--transition-fast);
  }

  .cat-section__header:hover {
    opacity: 0.85;
  }

  .cat-section__header-text {
    flex: 1;
    min-width: 0;
  }

  .cat-section__icon {
    width: 48px;
    height: 48px;
    background: var(--color-accent-subtle);
    border-radius: var(--radius-sm);
